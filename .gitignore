# Nested working copies are ignored rather than recorded as bare gitlinks.
#
# A gitlink (mode 160000) with no .gitmodules is unresolvable: anyone cloning
# gets an empty directory and no way to fetch it. That pattern was cleaned up on
# 2026-09-17 and this file prevents it recurring.

# bubble-watch lives in its own repo:
#   https://github.com/daimexmachina/bubble-watch
bubble-watch/

# murmuration_rust lives in its own repo:
#   https://github.com/daimexmachina/murmuration-rust
murmuration_rust/

# Secrets and personal data must never land here.
*.env
.env
